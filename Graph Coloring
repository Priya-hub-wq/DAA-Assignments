
#include <iostream>
#include <vector>
#include <algorithm>
#include <set>
#include <numeric>
using namespace std;

using Graph = vector<vector<int>>;

vector<string> colors = {
    "Red", "Blue", "Green", "Yellow",
    "Orange", "Purple", "Pink", "Brown"
};

// Greedy Colouring
vector<int> greedy(Graph &g, vector<int> order) {
    int n = g.size();
    vector<int> color(n, -1);

    for (int u : order) {
        set<int> used;
        for (int v : g[u])
            if (color[v] != -1)
                used.insert(color[v]);

        int c = 0;
        while (used.count(c))
            c++;

        color[u] = c;
    }
    return color;
}

// Welsh-Powell Algorithm
vector<int> welshPowell(Graph &g) {
    int n = g.size();
    vector<int> order(n);
    iota(order.begin(), order.end(), 0);

    sort(order.begin(), order.end(), [&](int a, int b) {
        if (g[a].size() != g[b].size())
            return g[a].size() > g[b].size();
        return a < b;
    });

    return greedy(g, order);
}

// DSATUR Algorithm
vector<int> dsatur(Graph &g) {
    int n = g.size();
    vector<int> color(n, -1);

    for (int step = 0; step < n; step++) {
        int best = -1, bestSat = -1, bestDegree = -1;

        for (int u = 0; u < n; u++) {
            if (color[u] != -1) continue;

            set<int> neighbourColors;
            for (int v : g[u])
                if (color[v] != -1)
                    neighbourColors.insert(color[v]);

            int sat = neighbourColors.size();
            int degree = g[u].size();

            if (sat > bestSat ||
                (sat == bestSat && degree > bestDegree)) {
                best = u;
                bestSat = sat;
                bestDegree = degree;
            }
        }

        set<int> used;
        for (int v : g[best])
            if (color[v] != -1)
                used.insert(color[v]);

        int c = 0;
        while (used.count(c))
            c++;

        color[best] = c;
    }

    return color;
}

// Display actual colour names and exam slots
void display(string name, vector<int> color) {
    int slots = *max_element(color.begin(), color.end()) + 1;

    cout << "\n========== " << name << " ==========\n";
    cout << "Course\tColour\t\tExam Slot\n";

    for (int i = 0; i < (int)color.size(); i++) {
        string colourName = color[color.size() - 1] >= 0
                            ? colors[color[i] % colors.size()]
                            : "None";

        cout << "C" << i + 1 << "\t"
             << colourName << "\t\t"
             << "Slot " << color[i] + 1 << "\n";
    }

    cout << "\nExam Timetable:\n";

    for (int s = 0; s < slots; s++) {
        cout << "Slot " << s + 1
             << " (" << colors[s % colors.size()] << "): ";

        for (int i = 0; i < (int)color.size(); i++)
            if (color[i] == s)
                cout << "C" << i + 1 << " ";

        cout << "\n";
    }

    cout << "Total exam slots required: " << slots << "\n";
}

int main() {
    int n, m;

    cout << "Enter number of courses and students: ";
    cin >> n >> m;

    if (n <= 0 || m < 0) {
        cout << "Invalid input.\n";
        return 1;
    }

    Graph g(n);

    cout << "For each student, enter number of courses "
         << "followed by course numbers:\n";

    for (int i = 0; i < m; i++) {
        int k;
        cin >> k;

        if (k < 0 || k > n) {
            cout << "Invalid number of courses for student.\n";
            return 1;
        }

        vector<int> courses(k);

        for (int j = 0; j < k; j++) {
            cin >> courses[j];

            if (courses[j] < 1 || courses[j] > n) {
                cout << "Invalid course number.\n";
                return 1;
            }

            courses[j]--;
        }

        sort(courses.begin(), courses.end());
        courses.erase(
            unique(courses.begin(), courses.end()),
            courses.end()
        );

        for (int a = 0; a < (int)courses.size(); a++) {
            for (int b = a + 1; b < (int)courses.size(); b++) {
                int u = courses[a], v = courses[b];
                g[u].push_back(v);
                g[v].push_back(u);
            }
        }
    }

    // Remove duplicate edges
    for (auto &adj : g) {
        sort(adj.begin(), adj.end());
        adj.erase(unique(adj.begin(), adj.end()), adj.end());
    }

    vector<int> order(n);
    iota(order.begin(), order.end(), 0);

    display("GREEDY COLOURING", greedy(g, order));
    display("WELSH-POWELL", welshPowell(g));
    display("DSATUR", dsatur(g));

    return 0;
}
